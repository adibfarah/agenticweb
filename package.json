{
  "name": "agenticweb-monorepo",
  "private": true,
  "type": "module",
  "description": "Turn any website you own into an agent-ready site: llms.txt, MCP, and actions, generated by Claude.",
  "workspaces": [
    "packages/*",
    "integrations/claude-code-plugin",
    "examples",
    "bench"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "agenticweb": "tsx packages/cli/src/bin.ts",
    "demo:sites": "tsx examples/serve.ts",
    "build": "node scripts/build.ts",
    "bench": "node bench/run.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
